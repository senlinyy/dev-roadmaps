{
  "language": "yaml",
  "completionProfile": "kubernetes",
  "activeFile": "httproute.yaml",
  "files": [
    {
      "filename": "gateway.yaml",
      "readOnly": true,
      "initialValue": "apiVersion: gateway.networking.k8s.io/v1\nkind: Gateway\nmetadata:\n  name: public-api\n  namespace: platform-networking\nspec:\n  gatewayClassName: shared-public\n  listeners:\n    - name: https\n      protocol: HTTPS\n      port: 443\n      hostname: api.devpolaris.local\n"
    },
    {
      "filename": "service.yaml",
      "readOnly": true,
      "initialValue": "apiVersion: v1\nkind: Service\nmetadata:\n  name: orders-api\n  namespace: orders\nspec:\n  selector:\n    app.kubernetes.io/name: orders-api\n  ports:\n    - name: http\n      port: 80\n      targetPort: http\n"
    },
    {
      "filename": "httproute.yaml",
      "initialValue": "apiVersion: gateway.networking.k8s.io/v1\nkind: HTTPRoute\nmetadata:\n  name: orders-api\n  namespace: orders\nspec:\n"
    }
  ],
  "grader": {
    "strategy": "kubernetes-manifests",
    "minResources": 3,
    "maxResources": 3,
    "allowedResources": [
      { "apiVersion": "gateway.networking.k8s.io/v1", "kind": "Gateway" },
      { "apiVersion": "gateway.networking.k8s.io/v1", "kind": "HTTPRoute" },
      { "apiVersion": "v1", "kind": "Service" }
    ],
    "resources": [
      {
        "select": { "file": "httproute.yaml", "apiVersion": "gateway.networking.k8s.io/v1", "kind": "HTTPRoute", "name": "orders-api", "namespace": "orders" },
        "paths": [
          { "path": ["spec", "parentRefs"], "minItems": 1, "maxItems": 1, "label": "single parent Gateway attachment" },
          { "path": ["spec", "parentRefs", 0, "namespace"], "equals": "platform-networking", "label": "parent Gateway namespace" },
          { "path": ["spec", "parentRefs", 0, "sectionName"], "equals": "https", "label": "HTTPS listener attachment" },
          { "path": ["spec", "hostnames"], "includes": "api.devpolaris.local", "minItems": 1, "maxItems": 1, "label": "route hostname" },
          { "path": ["spec", "rules", 0, "matches", 0, "path", "type"], "equals": "PathPrefix", "label": "path family match type" },
          { "path": ["spec", "rules", 0, "matches", 0, "path", "value"], "equals": "/orders", "label": "orders path" },
          { "path": ["spec", "rules", 0, "backendRefs", 0, "port"], "equals": 80, "label": "orders Service port" }
        ]
      }
    ],
    "relationships": [
      {
        "type": "reference-exists",
        "source": { "kind": "HTTPRoute", "name": "orders-api", "namespace": "orders" },
        "path": ["spec", "parentRefs", "*", "name"],
        "target": { "apiVersion": "gateway.networking.k8s.io/v1", "kind": "Gateway" },
        "namespace": "platform-networking",
        "label": "HTTPRoute parent Gateway reference"
      },
      {
        "type": "reference-exists",
        "source": { "kind": "HTTPRoute", "name": "orders-api", "namespace": "orders" },
        "path": ["spec", "rules", "*", "backendRefs", "*", "name"],
        "target": { "apiVersion": "v1", "kind": "Service" },
        "label": "HTTPRoute backend Service reference"
      }
    ]
  }
}
