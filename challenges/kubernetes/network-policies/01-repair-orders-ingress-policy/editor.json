{
  "language": "yaml",
  "completionProfile": "kubernetes",
  "activeFile": "network-policy.yaml",
  "files": [
    {
      "filename": "checkout-namespace.yaml",
      "readOnly": true,
      "initialValue": "apiVersion: v1\nkind: Namespace\nmetadata:\n  name: checkout\n  labels:\n    kubernetes.io/metadata.name: checkout\n"
    },
    {
      "filename": "checkout-deployment.yaml",
      "readOnly": true,
      "initialValue": "apiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: checkout-web\n  namespace: checkout\nspec:\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: checkout-web\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: checkout-web\n        app.kubernetes.io/component: web\n    spec:\n      containers:\n        - name: web\n          image: ghcr.io/devpolaris/checkout-web:2026.08.1\n"
    },
    {
      "filename": "orders-deployment.yaml",
      "readOnly": true,
      "initialValue": "apiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: orders-api\n  namespace: orders\nspec:\n  selector:\n    matchLabels:\n      app.kubernetes.io/name: orders-api\n  template:\n    metadata:\n      labels:\n        app.kubernetes.io/name: orders-api\n        app.kubernetes.io/component: api\n    spec:\n      containers:\n        - name: api\n          image: ghcr.io/devpolaris/orders-api:2026.08.1\n          ports:\n            - name: http\n              containerPort: 8080\n"
    },
    {
      "filename": "network-policy.yaml",
      "initialValue": "apiVersion: networking.k8s.io/v1\nkind: NetworkPolicy\nmetadata:\n  name: allow-checkout-web-to-orders-api\n  namespace: orders\nspec:\n"
    }
  ],
  "grader": {
    "strategy": "kubernetes-manifests",
    "minResources": 4,
    "maxResources": 4,
    "allowedResources": [
      { "apiVersion": "v1", "kind": "Namespace" },
      { "apiVersion": "apps/v1", "kind": "Deployment" },
      { "apiVersion": "networking.k8s.io/v1", "kind": "NetworkPolicy" }
    ],
    "resources": [
      {
        "select": { "file": "network-policy.yaml", "apiVersion": "networking.k8s.io/v1", "kind": "NetworkPolicy", "name": "allow-checkout-web-to-orders-api", "namespace": "orders" },
        "paths": [
          { "path": ["spec", "policyTypes"], "includes": "Ingress", "minItems": 1, "maxItems": 1, "label": "ingress-only policy type" },
          { "path": ["spec", "ingress"], "minItems": 1, "maxItems": 1, "label": "single scoped ingress rule" },
          { "path": ["spec", "ingress", 0, "from"], "minItems": 1, "maxItems": 1, "label": "single combined source peer" },
          { "path": ["spec", "ingress", 0, "ports"], "containsObject": { "protocol": "TCP", "port": 8080 }, "minItems": 1, "maxItems": 1, "label": "single orders API Pod port" }
        ]
      }
    ],
    "relationships": [
      {
        "type": "selector-matches",
        "source": { "kind": "NetworkPolicy", "name": "allow-checkout-web-to-orders-api", "namespace": "orders" },
        "sourcePath": ["spec", "podSelector", "matchLabels"],
        "target": { "kind": "Deployment", "name": "orders-api", "namespace": "orders" },
        "targetPath": ["spec", "template", "metadata", "labels"],
        "label": "protected orders API selector"
      },
      {
        "type": "selector-matches",
        "source": { "kind": "NetworkPolicy", "name": "allow-checkout-web-to-orders-api", "namespace": "orders" },
        "sourcePath": ["spec", "ingress", 0, "from", 0, "podSelector", "matchLabels"],
        "target": { "kind": "Deployment", "name": "checkout-web", "namespace": "checkout" },
        "targetPath": ["spec", "template", "metadata", "labels"],
        "label": "allowed checkout workload selector"
      },
      {
        "type": "selector-matches",
        "source": { "kind": "NetworkPolicy", "name": "allow-checkout-web-to-orders-api", "namespace": "orders" },
        "sourcePath": ["spec", "ingress", 0, "from", 0, "namespaceSelector", "matchLabels"],
        "target": { "kind": "Namespace", "name": "checkout" },
        "targetPath": ["metadata", "labels"],
        "label": "allowed checkout namespace selector"
      }
    ]
  }
}
