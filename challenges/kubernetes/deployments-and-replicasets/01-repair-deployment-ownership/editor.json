{
  "language": "yaml",
  "completionProfile": "kubernetes",
  "activeFile": "deployment.yaml",
  "files": [
    {
      "filename": "configmap.yaml",
      "initialValue": "apiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: notification-api-config\n  namespace: notifications\n"
    },
    {
      "filename": "deployment.yaml",
      "initialValue": "apiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: notification-api\n  namespace: notifications\nspec:\n  replicas: 3\n"
    }
  ],
  "grader": {
    "strategy": "kubernetes-manifests",
    "minResources": 2,
    "maxResources": 2,
    "allowedResources": [
      { "apiVersion": "v1", "kind": "ConfigMap" },
      { "apiVersion": "apps/v1", "kind": "Deployment" }
    ],
    "resources": [
      {
        "select": { "file": "configmap.yaml", "apiVersion": "v1", "kind": "ConfigMap", "name": "notification-api-config", "namespace": "notifications" },
        "paths": [
          { "path": ["data", "LOG_LEVEL"], "equals": "info", "label": "LOG_LEVEL setting" },
          { "path": ["data", "DELIVERY_MODE"], "equals": "async", "label": "DELIVERY_MODE setting" }
        ]
      },
      {
        "select": { "file": "deployment.yaml", "apiVersion": "apps/v1", "kind": "Deployment", "name": "notification-api", "namespace": "notifications" },
        "paths": [
          { "path": ["spec", "replicas"], "equals": 3, "label": "desired replica count" },
          { "path": ["spec", "selector", "matchLabels", "app.kubernetes.io/name"], "equals": "notification-api", "label": "selector application label" },
          { "path": ["spec", "selector", "matchLabels", "app.kubernetes.io/component"], "equals": "api", "label": "selector component label" },
          { "path": ["spec", "template", "spec", "containers"], "containsObject": { "name": "api", "image": "ghcr.io/customer-notification/notification-api:2026.06.14-1" }, "label": "approved API container" },
          { "path": ["spec", "template", "spec", "containers", 0, "ports"], "containsObject": { "name": "http", "containerPort": 8080 }, "label": "named application port" },
          { "path": ["spec", "template", "spec", "containers", 0, "envFrom"], "containsObject": { "configMapRef": { "name": "notification-api-config" } }, "label": "runtime ConfigMap import" }
        ]
      }
    ],
    "relationships": [
      {
        "type": "workload-selector",
        "workload": { "kind": "Deployment", "name": "notification-api", "namespace": "notifications" },
        "label": "notification API ownership contract"
      },
      {
        "type": "reference-exists",
        "source": { "kind": "Deployment", "name": "notification-api", "namespace": "notifications" },
        "path": ["spec", "template", "spec", "containers", "*", "envFrom", "*", "configMapRef", "name"],
        "target": { "apiVersion": "v1", "kind": "ConfigMap" },
        "label": "Deployment ConfigMap reference"
      }
    ]
  }
}
