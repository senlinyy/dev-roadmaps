{
  "cwd": "/home/dev",
  "env": {
    "USER": "dev",
    "HOME": "/home/dev"
  },
  "fs": {
    "/home/dev": {
      "type": "dir",
      "owner": "dev",
      "group": "dev",
      "mode": 493
    },
    "/etc/resolv.conf": {
      "type": "file",
      "content": "nameserver 10.20.0.53\n",
      "mode": 420
    }
  },
  "commandModules": [
    "linux-system",
    "networking"
  ],
  "system": {
    "services": [],
    "processes": {
      "entries": []
    },
    "network": {
      "interfaces": [
        {
          "name": "lo",
          "index": 1,
          "mac": "00:00:00:00:00:00",
          "mtu": 65536,
          "up": true,
          "carrier": true,
          "addresses": [
            "127.0.0.1/8"
          ]
        },
        {
          "name": "eth0",
          "index": 2,
          "mac": "52:54:00:20:00:10",
          "mtu": 1500,
          "up": true,
          "carrier": true,
          "addresses": [
            "10.20.0.10/24"
          ]
        }
      ],
      "routes": [
        {
          "prefix": "0.0.0.0/0",
          "via": "10.20.0.1",
          "dev": "eth0",
          "src": "10.20.0.10"
        }
      ],
      "neighbors": [
        {
          "address": "10.20.0.1",
          "dev": "eth0",
          "mac": "52:54:00:20:00:01",
          "state": "REACHABLE"
        }
      ],
      "resolver": "10.20.0.53",
      "dnsScenario": {
        "servers": [
          {
            "address": "10.20.0.53",
            "name": "corp-resolver.example.com",
            "recursive": true,
            "view": [
              "public"
            ]
          },
          {
            "address": "1.1.1.1",
            "name": "public-resolver.example",
            "recursive": true,
            "view": [
              "public"
            ]
          },
          {
            "address": "192.0.2.53",
            "name": "ns1.example.com",
            "recursive": false
          }
        ],
        "zones": [
          {
            "id": "public",
            "name": "example.com",
            "server": "192.0.2.53",
            "negativeTtl": 60,
            "records": [
              {
                "name": "example.com",
                "type": "SOA",
                "value": "ns1.example.com. hostmaster.example.com. 2026090401 3600 600 86400 60",
                "ttl": 300
              },
              {
                "name": "example.com",
                "type": "NS",
                "value": "ns1.example.com.",
                "ttl": 300
              },
              {
                "name": "ns1.example.com",
                "type": "A",
                "value": "192.0.2.53",
                "ttl": 300
              },
              {
                "name": "app.example.com",
                "type": "A",
                "value": "203.0.113.25",
                "ttl": 300
              },
              {
                "name": "app.example.com",
                "type": "AAAA",
                "value": "2001:db8:10::25",
                "ttl": 300
              },
              {
                "name": "www.example.com",
                "type": "CNAME",
                "value": "app.example.com.",
                "ttl": 300
              },
              {
                "name": "mail.example.com",
                "type": "MX",
                "value": "10 mx.example.com.",
                "ttl": 300
              },
              {
                "name": "new.example.com",
                "type": "A",
                "value": "203.0.113.25",
                "ttl": 300
              }
            ]
          }
        ],
        "initialCache": [
          {
            "resolver": "10.20.0.53",
            "name": "new.example.com",
            "type": "A",
            "storedAt": 0,
            "expiresAt": 60,
            "status": "NXDOMAIN",
            "answers": [],
            "authority": [
              {
                "name": "example.com",
                "type": "SOA",
                "value": "ns1.example.com. hostmaster.example.com. 2026090401 3600 600 86400 60",
                "ttl": 60
              }
            ],
            "authoritative": false
          }
        ]
      },
      "endpoints": [
        {
          "address": "203.0.113.25",
          "port": 443,
          "outcome": "open",
          "tls": {
            "hostname": "new.example.com"
          },
          "http": [
            {
              "path": "/health",
              "status": 200,
              "reason": "OK",
              "headers": {
                "content-type": "application/json"
              },
              "body": "{\"status\":\"ok\"}\n"
            }
          ]
        }
      ]
    }
  },
  "grader": {
    "strategy": "final-fs-state",
    "expectedFs": [],
    "requireCommands": [
      "dig",
      "sleep",
      "curl"
    ],
    "expectedNetwork": {
      "readOnly": true,
      "observations": [
        {
          "kind": "dns",
          "target": "new.example.com",
          "queryType": "A",
          "resolver": "10.20.0.53",
          "full": true,
          "outcome": "NXDOMAIN",
          "label": "Inspect corporate DNS before waiting.",
          "cacheHit": true,
          "maxTime": 60,
          "contains": [
            "IN SOA"
          ]
        },
        {
          "kind": "dns",
          "target": "new.example.com",
          "queryType": "A",
          "resolver": "1.1.1.1",
          "full": true,
          "outcome": "NOERROR",
          "label": "Compare public DNS before waiting.",
          "maxTime": 60,
          "contains": [
            "IN A 203.0.113.25"
          ]
        },
        {
          "kind": "dns",
          "target": "new.example.com",
          "queryType": "A",
          "resolver": "192.0.2.53",
          "full": true,
          "outcome": "NOERROR",
          "label": "Compare authority before waiting.",
          "maxTime": 60,
          "authoritative": true,
          "contains": [
            "IN A 203.0.113.25"
          ]
        },
        {
          "kind": "dns",
          "target": "new.example.com",
          "queryType": "A",
          "resolver": "10.20.0.53",
          "full": true,
          "outcome": "NOERROR",
          "label": "Verify a new corporate lookup after expiry.",
          "minTime": 60,
          "contains": [
            "IN A 203.0.113.25"
          ]
        },
        {
          "kind": "http",
          "target": "https://new.example.com/health",
          "outcome": "http",
          "verbose": true,
          "headers": true,
          "contains": [
            "HTTP/1.1 200 OK"
          ],
          "label": "Verify HTTPS health through the original hostname and resolver."
        }
      ]
    }
  }
}
