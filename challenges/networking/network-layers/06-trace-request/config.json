{
  "cwd": "/home/dev",
  "permissions": {
    "currentUser": "dev",
    "users": [
      { "name": "dev", "uid": 1000, "primaryGroup": "dev" },
      { "name": "root", "uid": 0, "primaryGroup": "root" }
    ]
  },
  "env": {
    "USER": "dev",
    "HOME": "/home/dev"
  },
  "fs": {
    "/home/dev": {
      "type": "dir",
      "owner": "dev",
      "group": "dev",
      "mode": 493
    }
  },
  "commandModules": [
    "linux-system",
    "networking"
  ],
  "system": {
    "services": [],
    "network": {
      "interfaces": [
        {
          "name": "lo",
          "index": 1,
          "mac": "00:00:00:00:00:00",
          "mtu": 65536,
          "up": true,
          "carrier": true,
          "addresses": [
            "127.0.0.1/8"
          ]
        },
        {
          "name": "eth0",
          "index": 2,
          "mac": "52:54:00:20:00:10",
          "mtu": 1500,
          "up": true,
          "carrier": true,
          "addresses": [
            "10.20.0.10/24"
          ]
        },
        {
          "name": "eth1",
          "index": 3,
          "mac": "52:54:00:30:00:10",
          "mtu": 1500,
          "up": false,
          "carrier": false,
          "addresses": [
            "10.30.0.10/24"
          ]
        }
      ],
      "routes": [
        {
          "prefix": "10.20.0.0/24",
          "dev": "eth0",
          "src": "10.20.0.10"
        },
        {
          "prefix": "10.40.0.0/16",
          "via": "10.20.0.254",
          "dev": "eth0",
          "src": "10.20.0.10",
          "metric": 10
        },
        {
          "prefix": "0.0.0.0/0",
          "via": "10.20.0.1",
          "dev": "eth0",
          "src": "10.20.0.10",
          "metric": 100
        }
      ],
      "neighbors": [
        {
          "address": "10.20.0.1",
          "dev": "eth0",
          "mac": "52:54:00:20:00:01",
          "state": "REACHABLE"
        },
        {
          "address": "10.20.0.254",
          "dev": "eth0",
          "mac": "52:54:00:20:00:fe",
          "state": "STALE"
        },
        {
          "address": "10.20.0.22",
          "dev": "eth0",
          "state": "FAILED"
        }
      ],
      "resolver": "10.20.0.53",
      "dns": [
        {
          "name": "app.example.com",
          "address": "203.0.113.25",
          "ttl": 300
        }
      ],
      "endpoints": [
        {
          "address": "203.0.113.25",
          "port": 443,
          "outcome": "open",
          "tls": {
            "hostname": "app.example.com"
          },
          "http": [
            {
              "path": "/health",
              "status": 503,
              "reason": "Service Unavailable",
              "headers": {
                "server": "nginx",
                "content-type": "application/json",
                "x-request-id": "edge-74f2"
              },
              "body": "{\"status\":\"degraded\",\"upstream\":\"inventory\"}\n"
            }
          ]
        },
        {
          "address": "203.0.113.25",
          "port": 8443,
          "outcome": "timeout"
        },
        {
          "address": "203.0.113.25",
          "port": 8080,
          "outcome": "refused"
        }
      ],
      "flows": [
        {
          "id": "public-https",
          "destination": "203.0.113.25",
          "port": 443,
          "sourcePort": 53142
        },
        {
          "id": "legacy-https",
          "destination": "203.0.113.25",
          "port": 8443,
          "sourcePort": 53143
        }
      ]
    }
  },
  "grader": {
    "strategy": "final-fs-state",
    "expectedFs": [],
    "expectedNetwork": {
      "readOnly": true,
      "observations": [
        {
          "kind": "dns",
          "target": "app.example.com",
          "outcome": "NOERROR",
          "contains": [
            "203.0.113.25"
          ],
          "label": "Resolve the requested hostname."
        },
        {
          "kind": "route",
          "target": "203.0.113.25",
          "label": "Inspect the route to the resolved address."
        },
        {
          "kind": "probe",
          "target": "203.0.113.25",
          "port": 443,
          "outcome": "open",
          "label": "Verify transport to the requested endpoint."
        },
        {
          "kind": "http",
          "verbose": true,
          "headers": true,
          "target": "https://app.example.com/health",
          "outcome": "http",
          "contains": [
            "HTTP/1.1 503",
            "x-request-id: edge-74f2"
          ],
          "label": "Inspect the response after successful TLS validation."
        }
      ]
    },
    "requireCommands": [
      "dig",
      "ip",
      "nc",
      "curl"
    ]
  }
}
