          "name": "releases.service",
          "workload": {
            "command": "/usr/local/bin/check-releases",
            "message": "Release inventory checked successfully; no changes required."
          }
        },
        {
          "name": "releases.timer"
        }
      ]
    }
  },
  "grader": {
    "strategy": "final-fs-state",
    "requireCommands": [
      "systemctl"
    ],
    "expectedUnits": [
      {
        "name": "releases.service",
        "label": "Maintenance job",
        "state": "inactive",
        "currentDefinition": true,
        "successfulRuns": 1,
        "verified": [
          "journal"
        ],
        "loaded": {
          "Service.Type": "oneshot",
          "Service.User": "deploy"
        }
      },
      {
        "name": "releases.timer",
        "label": "Daily schedule",
        "state": "active",
        "enabled": true,
        "currentDefinition": true,
        "verified": [
          "list-timers"
        ],
        "loaded": {
          "Timer.OnCalendar": "*-*-* 03:30:00 UTC",
          "Timer.Persistent": "true",
          "Install.WantedBy": "timers.target"
        }
      }
    ],
    "expectedFs": {
      "/etc/systemd/system/releases.service": {
        "contentEquals": "[Unit]\nDescription=Check old application releases\n\n[Service]\nType=oneshot\nUser=deploy\nGroup=app\nExecStart=/usr/local/bin/check-releases\n"
      }
    }
