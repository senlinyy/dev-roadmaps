    },
    "/srv/orders": {
      "type": "dir",
      "owner": "app",
      "group": "app",
      "mode": 493
    },
    "/usr/bin/node": {
      "type": "file",
      "content": "Authored Node executable.\n",
      "owner": "root",
      "group": "root",
      "mode": 493
    },
    "/srv/orders/server.js": {
      "type": "file",
      "content": "console.log('orders application');\n",
      "owner": "root",
      "group": "root",
      "mode": 420
    },
    "/etc/orders/app.env": {
      "type": "file",
      "content": "NODE_ENV=production\nPORT=3000\nLOG_LEVEL=info\n",
      "owner": "root",
      "group": "root",
      "mode": 384
    },
    "/usr/lib/systemd/system/orders.service": {
      "type": "file",
      "content": "[Unit]\nDescription=Orders API\n\n[Service]\nType=simple\nUser=app\nGroup=app\nWorkingDirectory=/srv/orders\nEnvironmentFile=/etc/orders/app.env\nExecStart=/usr/bin/node /srv/orders/server.js\n\n[Install]\nWantedBy=multi-user.target\n",
      "owner": "root",
      "group": "root",
      "mode": 420
    },
    "/etc/systemd/system/orders.service.d": {
      "type": "dir",
      "owner": "root",
      "group": "root",
      "mode": 493
    }
  },
  "commandModules": [
    "permissions",
    "linux-system"
  ],
  "permissions": {
    "currentUser": "dev",
    "users": [
      {
        "name": "root",
        "uid": 0,
        "primaryGroup": "root"
      },
      {
        "name": "dev",
        "uid": 1000,
        "primaryGroup": "dev"
      },
      {
        "name": "app",
        "uid": 2000,
        "primaryGroup": "app"
      },
      {
        "name": "deploy",
        "uid": 2001,
        "primaryGroup": "app"
      }
    ],
    "umask": 18
  },
  "system": {
    "services": [],
    "manager": {
      "units": [
        {
          "name": "orders.service",
          "state": "active",
          "workload": {
            "command": "/usr/bin/node /srv/orders/server.js",
            "requiredEnv": {
              "NODE_ENV": "production"
            },
            "readPaths": [
              "server.js"
            ],
            "message": "Orders API initialized; listening on the configured port."
          }
        }
      ]
    }
  },
  "grader": {
    "strategy": "final-fs-state",
    "requireCommands": [
      "systemctl"
    ],
    "expectedUnits": [
      {
        "name": "orders.service",
        "label": "Orders API",
        "state": "active",
        "currentDefinition": true,
        "currentProcess": true,
        "loaded": {
          "Service.MemoryMax": "512M",
          "Service.CPUQuota": "80%",
          "Service.LimitNOFILE": "8192"
        },
        "process": {
          "user": "app",
          "nofile": 8192
        },
        "properties": [
          "MemoryMax",
          "CPUQuotaPerSecUSec",
          "MainPID"
        ],
        "readProcess": [
          "limits"
        ]
      }
    ],
    "expectedFs": {
      "/usr/lib/systemd/system/orders.service": {
        "contentEquals": "[Unit]\nDescription=Orders API\n\n[Service]\nType=simple\nUser=app\nGroup=app\nWorkingDirectory=/srv/orders\nEnvironmentFile=/etc/orders/app.env\nExecStart=/usr/bin/node /srv/orders/server.js\n\n[Install]\nWantedBy=multi-user.target\n"
      },
      "/etc/systemd/system/orders.service.d/limits.conf": {
        "type": "file"
      }
    }
  }
}
