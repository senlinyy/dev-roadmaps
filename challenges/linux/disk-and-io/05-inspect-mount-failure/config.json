{
  "cwd": "/home/dev",
  "env": {
    "USER": "dev",
    "HOME": "/home/dev"
  },
  "commandModules": [
    "permissions",
    "linux-system"
  ],
  "permissions": {
    "currentUser": "dev",
    "users": [
      {
        "name": "root",
        "uid": 0,
        "primaryGroup": "root"
      },
      {
        "name": "dev",
        "uid": 1000,
        "primaryGroup": "dev"
      },
      {
        "name": "app",
        "uid": 2000,
        "primaryGroup": "app"
      }
    ],
    "umask": 18
  },
  "fs": {
    "/home/dev": {
      "type": "dir",
      "mode": 493,
      "owner": "dev",
      "group": "dev"
    },
    "/var/lib/app": {
      "type": "dir",
      "mode": 493,
      "owner": "app",
      "group": "app"
    },
    "/etc/fstab": {
      "type": "file",
      "content": "UUID=11111111-1111-4111-8111-111111111111 / ext4 defaults 0 1\nUUID=22222222-2222-4222-8222-222222222222 /var/lib/app xfs defaults 0 2\n",
      "mode": 420,
      "owner": "root",
      "group": "root"
    }
  },
  "system": {
    "services": [],
    "processes": {
      "entries": [
        {
          "pid": 100,
          "ppid": 1,
          "user": "dev",
          "argv": [
            "/bin/bash"
          ],
          "state": "S"
        }
      ]
    },
    "disks": [
      {
        "mountpoint": "/",
        "device": "/dev/vda1",
        "fstype": "ext4",
        "bytes": 42949672960,
        "inodes": 10000
      },
      {
        "mountpoint": "/var/lib/app",
        "device": "/dev/vdb1",
        "fstype": "xfs",
        "bytes": 107374182400,
        "inodes": 10000,
        "options": "ro,relatime"
      }
    ],
    "storage": {
      "devices": [
        {
          "path": "/dev/vda",
          "majorMinor": "252,0",
          "bytes": 42950721536
        },
        {
          "path": "/dev/vda1",
          "majorMinor": "252,1",
          "parent": "/dev/vda",
          "partition": 1,
          "startBytes": 1048576,
          "bytes": 42949672960,
          "fstype": "ext4",
          "uuid": "11111111-1111-4111-8111-111111111111"
        },
        {
          "path": "/dev/vdb",
          "majorMinor": "252,16",
          "bytes": 107375230976
        },
        {
          "path": "/dev/vdb1",
          "majorMinor": "252,17",
          "parent": "/dev/vdb",
          "partition": 1,
          "startBytes": 1048576,
          "bytes": 107374182400,
          "fstype": "xfs",
          "uuid": "22222222-2222-4222-8222-222222222222"
        }
      ]
    },
    "manager": {
      "units": [],
      "journal": [
        {
          "kernel": true,
          "unit": "kernel",
          "at": 0,
          "boot": 0,
          "priority": 3,
          "message": "XFS (vdb1): metadata I/O error; filesystem requires recovery. Training incident mounted read-only pending investigation."
        }
      ]
    }
  },
  "grader": {
    "strategy": "final-fs-state",
    "expectedFs": {},
    "expectedStorage": {
      "readOnly": true,
      "observations": [
        {
          "kind": "mount",
          "target": "/var/lib/app",
          "label": "Inspect live mount options",
          "contains": [
            "ro,relatime"
          ]
        },
        {
          "kind": "capacity",
          "target": "/var/lib/app",
          "label": "Check capacity rather than assuming fullness"
        },
        {
          "kind": "read",
          "target": "/etc/fstab",
          "label": "Compare persistent mount intent",
          "contains": [
            "defaults"
          ]
        },
        {
          "kind": "fstab:verify",
          "target": "/etc/fstab",
          "label": "Validate supported persistent entries",
          "contains": [
            "valid"
          ]
        },
        {
          "kind": "kernel",
          "target": "",
          "label": "Inspect storage failure evidence",
          "contains": [
            "metadata I/O error"
          ]
        }
      ]
    },
    "requireCommands": [
      "findmnt",
      "df",
      "cat",
      "journalctl"
    ]
  }
}
