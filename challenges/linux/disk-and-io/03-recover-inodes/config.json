  "system": {
    "services": [],
    "processes": {
      "entries": [
        {
          "pid": 100,
          "ppid": 1,
          "user": "dev",
          "argv": [
            "/bin/bash"
          ],
          "state": "S"
        }
      ]
    },
    "disks": [
      {
        "mountpoint": "/",
        "device": "/dev/vda1",
        "fstype": "ext4",
        "bytes": 42949672960,
        "inodes": 10000
      },
      {
        "mountpoint": "/var/lib/app",
        "device": "/dev/vdb1",
        "fstype": "xfs",
        "bytes": 107374182400,
        "inodes": 15
      }
    ],
    "storage": {
      "devices": [
        {
          "path": "/dev/vda",
          "majorMinor": "252,0",
          "bytes": 42950721536
        },
        {
          "path": "/dev/vda1",
          "majorMinor": "252,1",
          "parent": "/dev/vda",
          "partition": 1,
          "startBytes": 1048576,
          "bytes": 42949672960,
          "fstype": "ext4",
          "uuid": "11111111-1111-4111-8111-111111111111"
        },
        {
          "path": "/dev/vdb",
          "majorMinor": "252,16",
          "bytes": 107375230976
        },
        {
          "path": "/dev/vdb1",
          "majorMinor": "252,17",
          "parent": "/dev/vdb",
          "partition": 1,
          "startBytes": 1048576,
          "bytes": 107374182400,
          "fstype": "xfs",
          "uuid": "22222222-2222-4222-8222-222222222222"
        }
      ]
    }
  },
  "grader": {
    "strategy": "final-fs-state",
    "expectedFs": {
      "/var/lib/app/cache/active/current.tmp": {
        "exists": true,
        "contentEquals": "active session\n"
      }
    },
    "expectedStorage": {
      "observations": [
        {
          "kind": "capacity",
          "target": "/var/lib/app",
          "label": "Check available bytes",
          "beforeChange": true
        },
        {
          "kind": "inodes",
          "target": "/var/lib/app",
          "label": "Check inode headroom",
          "beforeChange": true
        },
        {
          "kind": "find:one-fs",
          "target": "/var/lib/app/cache",
          "label": "Inspect the cache population",
          "beforeChange": true,
          "contains": [
            "expired/session-",
            "active/current.tmp"
          ]
        },
        {
          "kind": "inodes",
          "target": "/var/lib/app",
          "label": "Verify recovered inodes",
          "fresh": true
        }
      ]
    },
    "forbidFsPrefixes": [
      "/var/lib/app/cache/expired/"
    ],
    "expectedSystem": {
      "storage": [
        {
          "path": "/var/lib/app",
          "minFreeBytes": 1,
          "minFreeInodes": 8
        }
      ]
    },
    "requireCommands": [
      "df",
      "find",
      "rm"
    ]
  }
}
