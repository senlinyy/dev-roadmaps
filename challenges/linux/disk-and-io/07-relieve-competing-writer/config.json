  "grader": {
    "strategy": "final-fs-state",
    "expectedFs": {
      "/var/lib/app/orders.db": {
        "exists": true,
        "contentEquals": "live orders database\n",
        "sizeEquals": 5368709120
      },
      "/var/lib/app/reports/export.csv": {
        "exists": true,
        "contentEquals": "replayable report output\n",
        "sizeEquals": 1073741824
      }
    },
    "expectedStorage": {
      "recovered": true,
      "observations": [
        {
          "kind": "io:interval",
          "target": "vdb",
          "label": "Collect baseline device samples",
          "beforeChange": true,
          "count": 2,
          "minInterval": 5
        },
        {
          "kind": "read",
          "target": "/proc/1600/io",
          "label": "Compare export storage counters",
          "beforeChange": true,
          "count": 2,
          "minSpan": 5,
          "contains": [
            "write_bytes:"
          ]
        },
        {
          "kind": "open-files:pid",
          "target": "1600",
          "label": "Connect export to its open data file",
          "beforeChange": true
        },
        {
          "kind": "io:interval",
          "target": "vdb",
          "label": "Verify current device recovery",
          "count": 2,
          "minInterval": 5,
          "recovered": true,
          "fresh": true
        }
      ]
    },
    "expectedProcesses": [
      {
        "label": "Replayable export identity and normal termination",
        "pid": 1600,
        "inspectedFields": [
          "pid",
          "user",
          "cmd"
        ],
        "state": "exited",
        "signal": "TERM"
      },
      {
        "label": "Preserve and verify the orders API",
        "pid": 1500,
        "state": "S",
        "untouched": true,
        "verified": true
