        "sizeEquals": 75161927680
      },
      "/var/cache/releases/expired-build.tar": {
        "exists": false
      }
    },
    "expectedStorage": {
      "observations": [
        {
          "kind": "capacity",
          "target": "/",
          "label": "Check affected capacity",
          "beforeChange": true
        },
        {
          "kind": "usage:one-fs",
          "target": "/var",
          "label": "Measure only the affected filesystem",
          "beforeChange": true
        },
        {
          "kind": "find:one-fs",
          "target": "/var/cache/releases",
          "label": "Inspect cleanup candidates",
          "beforeChange": true,
          "contains": [
            "expired-build.tar"
          ]
        },
        {
          "kind": "capacity",
          "target": "/",
          "label": "Verify reclaimed root capacity",
          "fresh": true
        }
      ]
    },
    "expectedSystem": {
      "storage": [
        {
          "path": "/",
          "minFreeBytes": 10737418240,
          "minFreeInodes": 1
        }
      ]
    },
    "requireCommands": [
      "df",
      "du",
      "find",
      "rm"
    ]
