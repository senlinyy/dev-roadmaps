{
  "cwd": "/home/dev",
  "env": {
    "USER": "dev",
    "HOME": "/home/dev"
  },
  "commandModules": [
    "permissions",
    "linux-system"
  ],
  "permissions": {
    "currentUser": "dev",
    "users": [
      {
        "name": "root",
        "uid": 0,
        "primaryGroup": "root"
      },
      {
        "name": "dev",
        "uid": 1000,
        "primaryGroup": "dev"
      },
      {
        "name": "app",
        "uid": 2000,
        "primaryGroup": "app"
      }
    ],
    "umask": 18
  },
  "fs": {
    "/home/dev": {
      "type": "dir",
      "mode": 493,
      "owner": "dev",
      "group": "dev"
    },
    "/var/lib/app": {
      "type": "dir",
      "mode": 493,
      "owner": "app",
      "group": "app"
    },
    "/var/lib/app/orders.db": {
      "type": "file",
      "content": "protected orders database\n",
      "size": 96636764160,
      "mode": 420,
      "owner": "root",
      "group": "root"
    }
  },
  "system": {
    "services": [],
    "processes": {
      "entries": [
        {
          "pid": 100,
          "ppid": 1,
          "user": "dev",
          "argv": [
            "/bin/bash"
          ],
          "state": "S"
        }
      ]
    },
    "disks": [
      {
        "mountpoint": "/",
        "device": "/dev/vda1",
        "fstype": "ext4",
        "bytes": 42949672960,
        "inodes": 10000
      },
      {
        "mountpoint": "/var/lib/app",
        "device": "/dev/vdb1",
        "fstype": "xfs",
        "bytes": 107374182400,
        "inodes": 10000
      }
    ],
    "storage": {
      "devices": [
        {
          "path": "/dev/vda",
          "majorMinor": "252,0",
          "bytes": 42950721536
        },
        {
          "path": "/dev/vda1",
          "majorMinor": "252,1",
          "parent": "/dev/vda",
          "partition": 1,
          "startBytes": 1048576,
          "bytes": 42949672960,
          "fstype": "ext4",
          "uuid": "11111111-1111-4111-8111-111111111111"
        },
        {
          "path": "/dev/vdb",
          "majorMinor": "252,16",
          "bytes": 128850067456
        },
        {
          "path": "/dev/vdb1",
          "majorMinor": "252,17",
          "parent": "/dev/vdb",
          "partition": 1,
          "startBytes": 1048576,
          "bytes": 107374182400,
          "fstype": "xfs",
          "uuid": "22222222-2222-4222-8222-222222222222",
          "growable": true
        }
      ]
    }
  },
  "grader": {
    "strategy": "final-fs-state",
    "expectedFs": {
      "/var/lib/app/orders.db": {
        "exists": true,
        "contentEquals": "protected orders database\n",
        "sizeEquals": 96636764160
      }
    },
    "expectedStorage": {
      "observations": [
        {
          "kind": "topology:size",
          "target": "/dev/vdb1",
          "label": "Inspect the original partition",
          "beforeChange": true
        },
        {
          "kind": "mount",
          "target": "/var/lib/app",
          "label": "Confirm the XFS target",
          "beforeChange": true,
          "contains": [
            "xfs",
            "rw"
          ]
        },
        {
          "kind": "grow:partition",
          "target": "/dev/vdb1",
          "label": "Grow the authorized partition"
        },
        {
          "kind": "topology:size",
          "target": "/dev/vdb1",
          "label": "Verify the expanded partition",
          "beforeKind": "grow:filesystem",
          "contains": [
            "128849018880"
          ]
        },
        {
          "kind": "grow:filesystem",
          "target": "/dev/vdb1",
          "label": "Grow the mounted filesystem"
        },
        {
          "kind": "capacity",
          "target": "/var/lib/app",
          "label": "Verify the final filesystem capacity",
          "fresh": true
        }
      ],
      "sizes": [
        {
          "device": "/dev/vdb1",
          "bytes": 128849018880,
          "filesystemBytes": 128849018880
        }
      ]
    },
    "requireCommands": [
      "lsblk",
      "findmnt",
      "growpart",
      "xfs_growfs",
      "df"
    ]
  }
}
