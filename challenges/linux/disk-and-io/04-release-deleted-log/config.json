{
  "cwd": "/home/dev",
  "env": {
    "USER": "dev",
    "HOME": "/home/dev"
  },
  "commandModules": [
    "permissions",
    "linux-system"
  ],
  "permissions": {
    "currentUser": "dev",
    "users": [
      {
        "name": "root",
        "uid": 0,
        "primaryGroup": "root"
      },
      {
        "name": "dev",
        "uid": 1000,
        "primaryGroup": "dev"
      },
      {
        "name": "app",
        "uid": 2000,
        "primaryGroup": "app"
      }
    ],
    "umask": 18
  },
  "fs": {
    "/home/dev": {
      "type": "dir",
      "mode": 493,
      "owner": "dev",
      "group": "dev"
    },
    "/var/lib/app": {
      "type": "dir",
      "mode": 493,
      "owner": "app",
      "group": "app"
    },
    "/var/log/orders/access.log": {
      "type": "file",
      "content": "current log\n",
      "size": 1048576,
      "mode": 420,
      "owner": "root",
      "group": "root"
    },
    "/var/lib/orders/database.db": {
      "type": "file",
      "content": "protected live database\n",
      "size": 4294967296,
      "mode": 420,
      "owner": "root",
      "group": "root"
    }
  },
  "system": {
    "services": [
      {
        "name": "orders",
        "user": "app",
        "command": "/usr/bin/orders-api",
        "pid": 1500,
        "active": true,
        "logs": [
          "orders: accepting requests"
        ],
        "storage": {
          "path": "/var/log/orders",
          "minFreeBytes": 1048576
        }
      }
    ],
    "processes": {
      "entries": [
        {
          "pid": 100,
          "ppid": 1,
          "user": "dev",
          "argv": [
            "/bin/bash"
          ],
          "state": "S"
        }
      ]
    },
    "disks": [
      {
        "mountpoint": "/",
        "device": "/dev/vda1",
        "fstype": "ext4",
        "bytes": 42949672960,
        "inodes": 10000
      },
      {
        "mountpoint": "/var/lib/app",
        "device": "/dev/vdb1",
        "fstype": "xfs",
        "bytes": 107374182400,
        "inodes": 10000
      }
    ],
    "storage": {
      "devices": [
        {
          "path": "/dev/vda",
          "majorMinor": "252,0",
          "bytes": 42950721536
        },
        {
          "path": "/dev/vda1",
          "majorMinor": "252,1",
          "parent": "/dev/vda",
          "partition": 1,
          "startBytes": 1048576,
          "bytes": 42949672960,
          "fstype": "ext4",
          "uuid": "11111111-1111-4111-8111-111111111111"
        },
        {
          "path": "/dev/vdb",
          "majorMinor": "252,16",
          "bytes": 107375230976
        },
        {
          "path": "/dev/vdb1",
          "majorMinor": "252,17",
          "parent": "/dev/vdb",
          "partition": 1,
          "startBytes": 1048576,
          "bytes": 107374182400,
          "fstype": "xfs",
          "uuid": "22222222-2222-4222-8222-222222222222"
        }
      ]
    },
    "openFiles": [
      {
        "service": "orders",
        "path": "/var/log/orders/access.log.1",
        "inode": 900000,
        "size": 37580963840
      }
    ]
  },
  "grader": {
    "strategy": "final-fs-state",
    "expectedFs": {
      "/var/lib/orders/database.db": {
        "exists": true,
        "contentEquals": "protected live database\n",
        "sizeEquals": 4294967296
      },
      "/var/log/orders/access.log": {
        "exists": true,
        "contentEquals": "current log\n",
        "sizeEquals": 1048576
      }
    },
    "expectedStorage": {
      "observations": [
        {
          "kind": "capacity",
          "target": "/",
          "label": "Measure allocated capacity",
          "beforeChange": true
        },
        {
          "kind": "usage:one-fs",
          "target": "/var",
          "label": "Measure reachable files",
          "beforeChange": true
        },
        {
          "kind": "open-files:deleted",
          "target": "",
          "label": "Identify the open unlinked file",
          "beforeChange": true
        },
        {
          "kind": "capacity",
          "target": "/",
          "label": "Recheck capacity after restart",
          "fresh": true
        },
        {
          "kind": "open-files:clear",
          "target": "",
          "label": "Recheck deleted-open references",
          "fresh": true
        }
      ]
    },
    "expectedSystem": {
      "services": [
        "orders"
      ],
      "noDeletedOpenFiles": true,
      "storage": [
        {
          "path": "/",
          "minFreeBytes": 32212254720,
          "minFreeInodes": 1
        }
      ]
    },
    "requireCommands": [
      "df",
      "du",
      "lsof",
      "systemctl"
    ]
  }
}
