{
  "cwd": "/home/dev",
  "env": { "USER": "dev", "HOME": "/home/dev" },
  "fs": {
    "/home/dev": { "type": "dir" },
    "/etc": { "type": "dir" },
    "/etc/orders-api": { "type": "dir" },
    "/etc/orders-api/app.conf": { "type": "file", "content": "listen_port=8080\ndatabase_pool=20\n" },
    "/var/log/orders-api": { "type": "dir" },
    "/var/log/orders-api/error.log": { "type": "file", "content": "2026-08-30T08:12:01Z INFO loading configuration\n2026-08-30T08:12:01Z ERROR permission denied opening /srv/orders-api/releases/20260830/config.json\n2026-08-30T08:12:02Z ERROR startup aborted\n" },
    "/srv/orders-api": { "type": "dir" },
    "/srv/orders-api/release-20260830": { "type": "dir" },
    "/srv/orders-api/release-20260830/manifest.txt": { "type": "file", "content": "orders-api 2026.08.30\n" },
