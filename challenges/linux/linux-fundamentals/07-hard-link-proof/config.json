{
  "cwd": "/home/dev",
  "env": { "USER": "dev", "HOME": "/home/dev" },
  "fs": {
    "/home/dev": { "type": "dir" },
    "/home/dev/report.txt": { "type": "file", "content": "release approved\n" }
  },
  "grader": {
    "strategy": "final-fs-state",
    "expectedFs": {
