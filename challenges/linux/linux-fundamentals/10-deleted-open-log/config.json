  "fs": {
    "/home/dev": { "type": "dir" },
    "/proc/mounts-info": { "type": "file", "content": "/dev/vda1 ext4 40G 36.8G 1.2G 41943040 38587596 1258291 92% / 2621440 240000 2381440 10% rw,relatime\n" },
    "/var/log/syslog": { "type": "file", "content": "system healthy\n", "size": 125829120 },
