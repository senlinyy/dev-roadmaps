{
  "cwd": "/home/dev",
  "env": { "USER": "dev", "HOME": "/home/dev" },
  "fs": {
    "/home/dev": { "type": "dir" },
    "/etc": { "type": "dir" },
    "/etc/nginx/nginx.conf": { "type": "file", "content": "worker_processes auto;\n" },
    "/etc/orders-api/conf.d/database.conf": { "type": "file", "content": "host=db.internal\nport=5432\n" },
    "/etc/orders-api/conf.d/cache.conf": { "type": "file", "content": "host=cache.internal\n" },
    "/etc/ssh/sshd_config": { "type": "file", "content": "PermitRootLogin no\n" },
    "/opt/orders-api/bin/start": { "type": "file", "content": "#!/bin/sh\n" },
    "/opt/orders-api/config/app.conf": { "type": "file", "content": "port=8080\n" },
    "/opt/orders-api/config/worker.conf": { "type": "file", "content": "workers=4\n" },
    "/opt/orders-api/docs/runbook.txt": { "type": "file", "content": "Configuration is managed separately.\n" }
  },
  "grader": {
    "strategy": "contains",
    "source": "all-stdout",
    "loose": true,
    "expected": ["/etc/orders-api/conf.d/database.conf", "app.conf", "worker.conf", "bin", "config", "docs"],
    "requireCommands": ["find", "tree"]
  }
}
