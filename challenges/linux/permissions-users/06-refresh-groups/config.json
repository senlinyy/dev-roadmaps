{
  "cwd": "/home/dev",
  "env": { "USER": "dev", "HOME": "/home/dev" },
  "fs": {
    "/home": { "type": "dir", "mode": 493, "owner": "root", "group": "root" },
    "/home/dev": { "type": "dir", "mode": 488, "owner": "dev", "group": "dev" },
    "/var": { "type": "dir", "mode": 493, "owner": "root", "group": "root" },
    "/var/run": { "type": "dir", "mode": 493, "owner": "root", "group": "root" },
    "/var/run/docker.sock": { "type": "file", "content": "", "mode": 432, "owner": "root", "group": "docker" }
  },
  "commandModules": ["permissions"],
  "permissions": {
    "currentUser": "dev",
    "users": [
      { "name": "root", "uid": 0, "primaryGroup": "root", "gid": 0 },
      { "name": "dev", "uid": 1000, "primaryGroup": "dev", "gid": 1000, "supplementaryGroups": ["docker"] }
    ],
    "sessionGroups": ["dev"],
    "umask": 18
  },
  "grader": {
    "strategy": "permission-state",
    "requireCommands": ["id", "test", "newgrp"],
    "minCommandCount": 5,
    "expectedFs": {
      "/var/run/docker.sock": { "type": "file", "modeEquals": 432, "ownerEquals": "root", "groupEquals": "docker" }
    },
    "expectedPermissions": {
      "sessionGroups": ["dev", "docker"],
      "access": [
        { "user": "dev", "path": "/var/run/docker.sock", "operation": "read", "allowed": true }
      ],
      "diagnostics": ["denied:dev:read:/var/run/docker.sock"]
    }
  }
}
