{
  "cwd": "/home/dev",
  "env": { "USER": "dev", "HOME": "/home/dev", "PATH": "/usr/local/bin:/usr/bin:/bin:/usr/sbin" },
  "fs": {
    "/home/dev": { "type": "dir" },
    "/usr/sbin/nginx": { "type": "file", "content": "simulated nginx binary\n", "mode": 493 }
  },
  "commandModules": ["packages"],
  "packages": {
    "manager": "apt",
    "indexFresh": true,
    "repositories": [
      { "id": "noble-updates", "name": "Ubuntu Updates", "family": "apt", "url": "http://archive.ubuntu.com/ubuntu noble-updates", "enabled": true, "trusted": true }
    ],
    "packages": [
      { "name": "nginx", "architecture": "amd64", "installedVersion": "1.24.0-2ubuntu7.2", "candidateVersion": "1.24.0-2ubuntu7.3", "repository": "noble-updates", "summary": "Nginx web and reverse proxy server", "files": ["/usr/sbin/nginx"] }
    ]
  },
  "grader": {
    "strategy": "contains",
    "source": "all-stdout",
    "expected": [
      "Installed: 1.24.0-2ubuntu7.2",
      "Candidate: 1.24.0-2ubuntu7.3",
      "noble-updates",
      "nginx: /usr/sbin/nginx",
      "upgradable from: 1.24.0-2ubuntu7.2"
    ],
    "requireCommands": ["apt-cache", "dpkg", "apt"],
    "minCommandCount": 3
  }
}
