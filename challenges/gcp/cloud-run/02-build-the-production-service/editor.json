{
  "language": "yaml",
  "filename": "service.yaml",
  "completionProfile": "gcp-cloud-run",
  "initialValue": "apiVersion: serving.knative.dev/v1\nkind: Service\nmetadata:\n  name: orders-api\n  labels:\n    environment: production\nspec:\n  template:\n    metadata:\n      annotations: {}\n    spec:\n      serviceAccountName: default\n      containers:\n        - name: orders-api\n          image: \n          ports: []\n          env: []\n",
  "grader": {
    "strategy": "yaml-paths",
    "expected": [
      { "path": ["apiVersion"], "equals": "serving.knative.dev/v1" },
      { "path": ["kind"], "equals": "Service" },
      { "path": ["metadata", "name"], "equals": "orders-api" },
      { "path": ["spec", "template", "metadata", "annotations", "autoscaling.knative.dev/minScale"], "equals": "2" },
      { "path": ["spec", "template", "metadata", "annotations", "autoscaling.knative.dev/maxScale"], "equals": "10" },
      { "path": ["spec", "template", "spec", "serviceAccountName"], "equals": "orders-runtime@devpolaris-prod.iam.gserviceaccount.com" },
      { "path": ["spec", "template", "spec", "containers", 0, "image"], "equals": "europe-west2-docker.pkg.dev/devpolaris-prod/apps/orders-api:2026.08.1" },
      { "path": ["spec", "template", "spec", "containers", 0, "ports"], "containsObject": { "name": "http1", "containerPort": 8080 }, "minItems": 1, "maxItems": 1 },
      { "path": ["spec", "template", "spec", "containers", 0, "env"], "containsObject": { "name": "PAYMENTS_API_TOKEN", "valueFrom": { "secretKeyRef": { "key": "latest", "name": "payments-api-token" } } }, "minItems": 1, "maxItems": 1 }
    ]
  }
}
