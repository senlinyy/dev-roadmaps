{
  "language": "json",
  "filename": "lifecycle.json",
  "completionProfile": "gcp-json",
  "initialValue": "{\n  \"lifecycle\": {\n    \"rule\": []\n  }\n}\n",
  "grader": {
    "strategy": "json-paths",
    "expected": [
      { "path": ["lifecycle", "rule"], "minItems": 2, "maxItems": 2 },
      { "path": ["lifecycle", "rule"], "containsObject": { "action": { "type": "SetStorageClass", "storageClass": "NEARLINE" }, "condition": { "age": 30, "matchesPrefix": ["exports/daily/"], "isLive": true } } },
      { "path": ["lifecycle", "rule"], "containsObject": { "action": { "type": "Delete" }, "condition": { "age": 365, "matchesPrefix": ["exports/daily/"], "isLive": true } } }
    ]
  }
}
