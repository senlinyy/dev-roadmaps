    "rules": [
      {
        "name": "deny",
        "bodyContains": [
          "some resource in input.resource_changes",
          "startswith(resource.type, \"aws_\")",
          "object.get(resource.change.after, \"tags\", {})",
          "{\"Owner\", \"Environment\"}",
          "count(missing) > 0",
          "message := sprintf("
        ]
      },
      {
        "name": "deny_delete",
        "bodyContains": [
          "some resource in input.resource_changes",
          "resource.change.actions == [\"delete\"]",
          "object.get(resource.change.before.tags, \"Environment\", \"\") == \"prod\"",
          "message := sprintf("
        ]
      }
    ]
  }
